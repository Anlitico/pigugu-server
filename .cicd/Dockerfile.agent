FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /pigagent

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libopus0 \
    && rm -rf /var/lib/apt/lists/*

COPY pigagent/pyproject.toml .
RUN python -c "import tomllib, subprocess, sys; \
    deps = tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; \
    subprocess.check_call([sys.executable, '-m', 'pip', 'install', '--no-cache-dir'] + deps)"

COPY pigagent/ .

# Fix silero-vad-lite: clear execstack flag on .so (container security blocks it otherwise)
RUN apt-get update && apt-get install -y --no-install-recommends prelink \
    && find /usr/local/lib -name 'silero_vad_lite*.so' -exec execstack -c {} \; \
    && apt-get remove -y prelink && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && python -c "import silero_vad_lite; print('silero-vad-lite OK')"

CMD ["python", "main.py", "start"]
