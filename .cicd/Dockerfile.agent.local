FROM docker.1ms.run/library/python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /pigagent

RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libopus0 \
    libsoxr0 \
    && rm -rf /var/lib/apt/lists/*

COPY pigagent/pyproject.toml .
RUN python -c "import tomllib, subprocess, sys; \
    deps = tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; \
    subprocess.check_call([sys.executable, '-m', 'pip', 'install', '--no-cache-dir', '-i', 'https://pypi.tuna.tsinghua.edu.cn/simple'] + deps)"

COPY pigagent/ .

CMD ["python", "main.py", "start"]
