# PostgreSQL
DATABASE_URL=postgresql+asyncpg://pigugu:pigugu@localhost:5432/pigugu

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LiveKit
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# AWS IoT Core
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_IOT_ENDPOINT=agktqmnw53qnj-ats.iot.us-west-1.amazonaws.com
AWS_IOT_WEBHOOK_SECRET=change-me

# MQTT / Device Token (separate from user auth JWT)
MQTT_JWT_SECRET_KEY=change-me-in-production-mqtt
MQTT_JWT_ALGORITHM=HS256
MQTT_JWT_EXPIRE_MINUTES=1440
MQTT_BROKER_URI=mqtts://agktqmnw53qnj-ats.iot.us-west-1.amazonaws.com:8883

# App
APP_ENV=development
LOG_LEVEL=INFO
