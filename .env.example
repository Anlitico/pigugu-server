# ══════════════════════════════════════════════════════════════════
# Pigugu Server — Environment Variables Template
# ══════════════════════════════════════════════════════════════════
#
# Copy to .env and fill in real values for local development.
# NEVER commit .env files — they contain real credentials.
#
# Production keys are managed via GitHub Secrets → K8s.
# ══════════════════════════════════════════════════════════════════

# ── Infrastructure ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pigugu

# ── LLM Providers ──────────────────────────────────────────────
DASHSCOPE_US_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ANTHROPIC_API_KEY=your-anthropic-api-key
XAI_API_KEY=xai-xxxxxxxxxxxxxxxx

# ── LiveKit ────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── STT / TTS ──────────────────────────────────────────────────
CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Search Providers ───────────────────────────────────────────
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── HTTP API ───────────────────────────────────────────────────
API_PORT=8080

# ── API Service ────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
APP_ENV=development
LOG_LEVEL=INFO

# ── API: AWS / IoT ─────────────────────────────────────────────
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-west-1.amazonaws.com
AWS_IOT_WEBHOOK_SECRET=
MQTT_BROKER_URI=mqtts://your-iot-endpoint.iot.us-west-1.amazonaws.com:8883
AWS_IOT_POLICY_NAME=pigugu_device_policy
