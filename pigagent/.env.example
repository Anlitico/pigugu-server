# ══════════════════════════════════════════════════════════════════
# Pigugu Voice Agent — Environment Variables
# ══════════════════════════════════════════════════════════════════
#
# This file documents all required environment variables.
# Copy to .env and fill in real values for local development.
#
# The .env file is for LOCAL TESTING ONLY.
# Production keys are configured in GitHub Actions secrets
# and injected at deploy time. NEVER commit real .env files.
# ══════════════════════════════════════════════════════════════════

# ── Infrastructure ──────────────────────────────────────────────

# Redis (AWS ElastiCache or local)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (AWS RDS or local)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pigugu

# ── LLM Providers ──────────────────────────────────────────────

# Alibaba Cloud DashScope (US endpoint)
DASHSCOPE_US_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Volcengine Ark (Doubao models)
ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── LiveKit ────────────────────────────────────────────────────

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── STT / TTS ──────────────────────────────────────────────────

# Cartesia (STT + TTS) — https://play.cartesia.ai
CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxx

# Deepgram (STT alternative) — https://console.deepgram.com
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Search Providers ───────────────────────────────────────────

# Tavily Search API — https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Perplexity Search API — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── HTTP API ───────────────────────────────────────────────────

# Port for the FastAPI server (default: 8080)
API_PORT=8080
