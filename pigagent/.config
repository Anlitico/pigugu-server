# Agent Configuration File
# Flat TOML config - no environment sections needed

# LiveKit Cloud Configuration
LIVEKIT_URL = "wss://shrump-test-jbnvclwi.livekit.cloud"

# STT Provider: "deepgram" (recommended) or "cartesia"
STT_PROVIDER = "deepgram"

# Deepgram STT Configuration (if using deepgram)
DEEPGRAM_STT_MODEL = "nova-3"
DEEPGRAM_STT_LANGUAGE = "en"
DEEPGRAM_STT_SAMPLE_RATE = 16000
DEEPGRAM_ENABLE_DIARIZATION = true

# Cartesia Configuration (STT & TTS)
CARTESIA_STT_MODEL = "ink-whisper"
CARTESIA_STT_LANGUAGE = "en"
CARTESIA_STT_ENCODING = "pcm_s16le"
CARTESIA_STT_SAMPLE_RATE = 16000
CARTESIA_STT_BASE_URL = "https://api.cartesia.ai"

CARTESIA_TTS_MODEL = "sonic-3"
CARTESIA_TTS_VOICE = "9783574a-63f4-46bf-b56b-928eb52d3140"
CARTESIA_TTS_LANGUAGE = "en"
CARTESIA_TTS_ENCODING = "pcm_s16le"
CARTESIA_TTS_SAMPLE_RATE = 24000
CARTESIA_TTS_SPEED = ""
CARTESIA_TTS_EMOTION = ""
CARTESIA_TTS_VOLUME = 1.0
CARTESIA_TTS_WORD_TIMESTAMPS = true
CARTESIA_TTS_BASE_URL = "https://api.cartesia.ai"

# LLM Configuration (Qwen via OpenAI plugin)
# LLM_PROVIDER: "qwen" (default China), "qwen-us" (US region), or "grok" (xAI)
LLM_PROVIDER = "grok"
QWEN_MODEL = "qwen-plus"
GROK_MODEL = "grok-4-1-fast-reasoning"

# LLM Settings
LLM_TEMPERATURE = 0.6
LLM_MAX_TOKENS = ""

# Agent Settings
AGENT_WORKERS = 1
AGENT_LOG_CONVERSATIONS = true
ENABLE_INTERRUPTIONS = true
SILENCE_THRESHOLD = 30.0

# Welcome Greeting
ENABLE_WELCOME_GREETING = true
WELCOME_GREETING = "Hello! I'm Trump, your AI companion. How can I help you today?"

# Advanced Agent Features
ENABLE_PREEMPTIVE_SYNTHESIS = true
ENABLE_TURN_DETECTOR = true
ENABLE_FILLER_WORDS = true
ENABLE_POLICY_SEARCH = true    # Web search for Policy Mode (long) answers
FORCE_POLICY_SEARCH = true    # Force search on every query (debug)

# Policy Search Backend: "built_in" (default) uses Qwen/Grok native search
#                        "perplexity" uses Perplexity Sonar via tool-based search
POLICY_SEARCH_BACKEND = "built_in"

# Perplexity Search Configuration (only used when POLICY_SEARCH_BACKEND = "perplexity")
PERPLEXITY_SEARCH_MODEL = "sonar-pro"
PERPLEXITY_SEARCH_BASE_URL = "https://api.perplexity.ai"

# Agent Mode: 1 = Default, 2 = Interrupt Mode
AGENT_MODE = 1
INTERRUPT_INTERVAL_SECONDS = 30.0

# Advanced Settings
ENGAGEMENT_THRESHOLD = 0.7
DEBATE_MODE_SILENCE_MULTIPLIER = 1.5

# Logging Configuration
LOG_LEVEL = "INFO"
LOG_TO_FILE = true
LOG_ROTATION = "00:00"
LOG_RETENTION = "7 days"
LOG_FILE_PATH = "logs/agent_{time:YYYY-MM-DD}.log"

# =============================================================================
# MANUAL VERIFICATION GUIDE FOR SEARCH BACKENDS
# =============================================================================
#
# To verify both built_in and perplexity search backends work correctly,
# test each of the four combinations manually:
#
# --- Setup ---
# 1. Ensure your .env file has the required API keys:
#    - For all modes: LIVEKIT_API_KEY, LIVEKIT_API_SECRET, CARTESIA_API_KEY
#    - For qwen: DASHSCOPE_API_KEY
#    - For grok: XAI_API_KEY
#    - For perplexity: PERPLEXITY_API_KEY or OPENROUTER_API_KEY
#
# 2. Start the agent normally:
#    cd agent && uv run python main.py dev
#
# 3. Connect via the web client and ask a fresh-information question like:
#    "What's the latest news about [current event]?"
#    "What happened in the stock market today?"
#
# --- Test Cases ---
#
# Test 1: Qwen + built_in (default behavior, unchanged)
#   LLM_PROVIDER = "qwen"
#   POLICY_SEARCH_BACKEND = "built_in"
#   Expected: Log shows "Using built-in provider-native search (qwen)"
#   Expected: Responses use Qwen's native search via enable_search=True
#
# Test 2: Grok + built_in (default behavior, unchanged)
#   LLM_PROVIDER = "grok"
#   POLICY_SEARCH_BACKEND = "built_in"
#   Expected: Log shows "Using built-in provider-native search (grok)"
#   Expected: Responses use Grok's native search via web_search tool
#
# Test 3: Qwen + perplexity (new tool-based search)
#   LLM_PROVIDER = "qwen"
#   POLICY_SEARCH_BACKEND = "perplexity"
#   Expected: Log shows "Using Perplexity tool-based search"
#   Expected: Log shows "[TOOL] Executed: web_search" when search is triggered
#   Expected: LLM receives tool results and uses them in response
#
# Test 4: Grok + perplexity (new tool-based search)
#   LLM_PROVIDER = "grok"
#   POLICY_SEARCH_BACKEND = "perplexity"
#   Expected: Log shows "Using Perplexity tool-based search"
#   Expected: Log shows "[TOOL] Executed: web_search" when search is triggered
#   Expected: LLM receives tool results and uses them in response
#
# --- Verification Checklist ---
# For all tests, verify:
#   [ ] Agent starts without validation errors
#   [ ] Startup log shows correct backend ("backend=built_in" or "backend=perplexity")
#   [ ] When asking fresh-info questions, appropriate search mode is used
#   [ ] Spoken responses do NOT contain raw URLs or citation markers like [[1]]
#   [ ] Responses sound natural (citations are woven into speech, not read aloud)
#
# --- Troubleshooting ---
# If Perplexity mode fails with "missing_perplexity_api_key":
#   Check that PERPLEXITY_API_KEY or OPENROUTER_API_KEY is set in .env
#
# If built_in mode fails with provider errors:
#   Check that the correct provider API key is set (DASHSCOPE_API_KEY or XAI_API_KEY)
#
# If search never triggers:
#   Set FORCE_POLICY_SEARCH = true to force search on every query (for debugging)
