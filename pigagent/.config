# Agent Configuration File
# Flat TOML config - no environment sections needed

# LiveKit Cloud Configuration
LIVEKIT_URL = "wss://shrump-test-jbnvclwi.livekit.cloud"

# STT Provider: "deepgram" (recommended) or "cartesia"
STT_PROVIDER = "deepgram"

# Deepgram STT Configuration (if using deepgram)
DEEPGRAM_STT_MODEL = "nova-3"
DEEPGRAM_STT_LANGUAGE = "en"
DEEPGRAM_STT_SAMPLE_RATE = 16000
DEEPGRAM_ENABLE_DIARIZATION = true

# Cartesia Configuration (STT & TTS)
CARTESIA_STT_MODEL = "ink-whisper"
CARTESIA_STT_LANGUAGE = "en"
CARTESIA_STT_ENCODING = "pcm_s16le"
CARTESIA_STT_SAMPLE_RATE = 16000
CARTESIA_STT_BASE_URL = "https://api.cartesia.ai"

CARTESIA_TTS_MODEL = "sonic-3"
CARTESIA_TTS_VOICE = "9783574a-63f4-46bf-b56b-928eb52d3140"
CARTESIA_TTS_LANGUAGE = "en"
CARTESIA_TTS_ENCODING = "pcm_s16le"
CARTESIA_TTS_SAMPLE_RATE = 24000
CARTESIA_TTS_SPEED = ""
CARTESIA_TTS_EMOTION = ""
CARTESIA_TTS_VOLUME = 1.0
CARTESIA_TTS_WORD_TIMESTAMPS = true
CARTESIA_TTS_BASE_URL = "https://api.cartesia.ai"

# LLM Configuration
QWEN_MODEL = "qwen-flash-us"

# LLM Settings
LLM_TEMPERATURE = 0.6
LLM_MAX_TOKENS = ""

# Agent Settings
AGENT_WORKERS = 1
ENABLE_INTERRUPTIONS = true
AGENT_MAX_STEPS = 5
ENDPOINTING_DELAY = 0.5

# Advanced Agent Features
ENABLE_PREEMPTIVE_SYNTHESIS = true
ENABLE_POLICY_SEARCH = true
POLICY_SEARCH_BACKEND = "built_in"

# Logging Configuration
LOG_LEVEL = "INFO"
LOG_TO_FILE = true
LOG_ROTATION = "00:00"
LOG_RETENTION = "7 days"
LOG_FILE_PATH = "logs/agent_{time:YYYY-MM-DD}.log"
